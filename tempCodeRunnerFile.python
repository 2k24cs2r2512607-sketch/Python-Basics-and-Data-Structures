def counting_sort(arr):
    if not arr:
        return arr
    max_value = max(arr)
    count = [0] * (max_value + 1)
    for num in arr:
        count[num] += 1
    sorted_arr = []
    for i in range(len(count)):
        while count[i] > 0:
            sorted_arr.append(i)
            count[i] -= 1
    return sorted_arr

arr = [4, 2, 2, 8, 3, 3, 1]
print("Original:", arr)
print("Sorted:", counting_sort(arr))